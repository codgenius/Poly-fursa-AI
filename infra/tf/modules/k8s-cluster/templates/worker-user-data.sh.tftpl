#!/bin/bash

set -euxo pipefail

exec > >(tee /var/log/worker-bootstrap.log | logger -t worker-bootstrap -s 2>/dev/console) 2>&1

export DEBIAN_FRONTEND=noninteractive

# Kubernetes requires swap to remain disabled.
swapoff -a
sed -i '/[[:space:]]swap[[:space:]]/s/^/#/' /etc/fstab

# Load the kernel modules and network settings needed by Kubernetes networking.
cat > /etc/modules-load.d/kubernetes.conf <<'EOF'
overlay
br_netfilter
EOF

modprobe overlay
modprobe br_netfilter

cat > /etc/sysctl.d/99-kubernetes.conf <<'EOF'
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
EOF

sysctl --system

# Install the AWS CLI and add the official Kubernetes and CRI-O repositories.
apt-get update
apt-get install -y awscli ca-certificates curl gpg

install -m 0755 -d /etc/apt/keyrings

curl -fsSL "https://pkgs.k8s.io/core:/stable:/${kubernetes_minor_version}/deb/Release.key" |
  gpg --batch --yes --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg

echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/${kubernetes_minor_version}/deb/ /" \
  > /etc/apt/sources.list.d/kubernetes.list

curl -fsSL "https://download.opensuse.org/repositories/isv:/cri-o:/stable:/${crio_minor_version}/deb/Release.key" |
  gpg --batch --yes --dearmor -o /etc/apt/keyrings/cri-o-apt-keyring.gpg

echo "deb [signed-by=/etc/apt/keyrings/cri-o-apt-keyring.gpg] https://download.opensuse.org/repositories/isv:/cri-o:/stable:/${crio_minor_version}/deb/ /" \
  > /etc/apt/sources.list.d/cri-o.list

apt-get update
apt-get install -y cri-o kubeadm kubectl kubelet
apt-mark hold cri-o kubeadm kubectl kubelet

systemctl enable --now crio
systemctl enable kubelet

# Every retry fetches the latest SSM value. This handles a missing or expired
# token while the control plane is starting or recovering from a long shutdown.
cat > /usr/local/sbin/join-kubernetes-cluster <<'EOF'
#!/bin/bash

set -euo pipefail

if [ -f /etc/kubernetes/kubelet.conf ]; then
  exit 0
fi

join_command="$(aws ssm get-parameter \
  --region "${aws_region}" \
  --name "${ssm_parameter_name}" \
  --with-decryption \
  --query 'Parameter.Value' \
  --output text)"

if [ -z "$join_command" ] || [ "$join_command" = "None" ]; then
  exit 1
fi

exec /bin/bash -c "$join_command --cri-socket=unix:///var/run/crio/crio.sock"
EOF

chmod 0700 /usr/local/sbin/join-kubernetes-cluster

# Retry automatically until the control plane publishes a usable command.
cat > /etc/systemd/system/kubernetes-worker-join.service <<'EOF'
[Unit]
Description=Join this worker to the Kubernetes cluster
After=network-online.target crio.service
Wants=network-online.target
Requires=crio.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/join-kubernetes-cluster
RemainAfterExit=true
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now kubernetes-worker-join.service
