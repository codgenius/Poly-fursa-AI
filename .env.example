# Image tags (used in docker-compose.yml)
# Set these before running: docker compose up
# Or in a .env file, docker-compose will read them automatically
YOLO_IMAGE_TAG=0.0.1
AGENT_IMAGE_TAG=0.0.2
MCP_IMAGE_TAG=0.0.1
FRONTEND_IMAGE_TAG=0.0.1

# AWS Credentials
AWS_REGION=us-east-1
AWS_S3_BUCKET=hadi-polyai-images-hk2026

# Fluent Bit container logs (EC2 deployment only)
S3_LOGS_BUCKET=your-polyai-logs-bucket
LOG_HOST=polyai-dev

# Agent Model
MODEL=bedrock:amazon.nova-micro-v1:0

# CORS configuration for local Docker Compose development.
# Kubernetes environment values are defined in the manifests under infra/k8s/.
ALLOWED_ORIGINS=http://localhost:3000
