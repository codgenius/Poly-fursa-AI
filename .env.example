# Image tags (used in docker-compose.yml)
# Set these before running: docker compose up
# Or in a .env file, docker-compose will read them automatically
YOLO_IMAGE_TAG=0.0.1
AGENT_IMAGE_TAG=0.0.2
MCP_IMAGE_TAG=0.0.1
FRONTEND_IMAGE_TAG=0.0.1

# AWS Credentials
AWS_REGION=us-east-1
AWS_S3_BUCKET=hadi-polyai-images-hk2026

# Agent Model
MODEL=bedrock:amazon.nova-micro-v1:0

# CORS Configuration - Set to frontend origin (dev or prod)
# Development:  http://dev.hadi.fursa.click:3000
# Production:   http://prod.hadi.fursa.click:3000
# Local/Docker: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
